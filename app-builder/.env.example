# Copy to .env (never commit it) and run `aio app deploy`.
WF_HOST=https://markszulc.my.workfront.com
# impersonate (default) = admin API key + per-user login; passthrough = forward the IMS token
WF_AUTH_STRATEGY=impersonate
WF_ADMIN_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000,https://da.live,https://markszulc.github.io
# Optional, comma-separated, e.g. acme.com
ALLOWED_EMAIL_DOMAINS=
